<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>BOOKSTORE | Online Book Shop</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- HEADER -->
    <header>
        <div class="logo">
            BOOKSTORE
        </div>

        <nav>
            <a href="#home">Home</a>
            <a href="#books">Books</a>
            <a href="#about">About Us</a>
            <a href="#contact">Contact</a>
        </nav>

<div class="header-buttons">
    <button class="login-btn" onclick="showLogin()">Login</button>
    <button class="signup-btn" onclick="showSignup()">Sign Up</button>
</div>
    </header>
<!-- LOGIN MODAL -->
<div id="login-modal" class="modal">
    <div class="modal-content">

        <span class="close"
        onclick="closeModal('login-modal')">&times;</span>

        <h2>Welcome Back</h2>
        <p>Login to your BOOKSTORE account</p>

        <label for="login-role">Choose Account Type</label>

        <select id="login-role">
            <option value="customer">Customer</option>
            <option value="staff">Staff</option>
        </select>

        <input
            type="email"
            id="login-email"
            placeholder="Email Address">

        <input
            type="password"
            id="login-password"
            placeholder="Password">

        <button onclick="login()">Login</button>

    </div>
</div>

<!-- SIGN UP MODAL -->
<div id="signup-modal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeModal('signup-modal')">&times;</span>

        <h2>Create Account</h2>
        <p>Join our bookstore today</p>

        <input type="text" id="signup-name" placeholder="Full Name">
        <input type="email" id="signup-email" placeholder="Email Address">
        <input type="password" id="signup-password" placeholder="Password">

        <button onclick="signup()">Sign Up</button>
    </div>
</div>

    <!-- HOME SECTION -->
    <section class="hero" id="home">

        <div class="hero-content">

            <p class="small-title">WELCOME TO OUR BOOKSTORE</p>

            <h1>
                Discover Your Next
                <span>Favorite Book</span>
            </h1>

            <p>
                Explore thousands of books and enjoy
                reading every day.
            </p>

            <a href="#books" class="hero-btn">
                Explore Books
            </a>

        </div>

    </section>

    <!-- BOOKS SECTION -->
    <section class="books-section" id="books">

        <div class="section-title">
    <p>OUR COLLECTION</p>
    <h2>Popular Books</h2>
</div>

<!-- BOOK SEARCH -->
<div class="book-search">
    <input
        type="text"
        id="book-search"
        placeholder="🔍 Search books by name..."
        oninput="searchBooks()"
    >
</div>
<!-- CATEGORY FILTER -->
<div class="category-filter">

    <select id="category-filter" onchange="filterBooks()">

        <option value="All">All Categories</option>

        <option value="Programming">Programming</option>

        <option value="History">History</option>

        <option value="Science">Science</option>

        <option value="Business">Business</option>

    </select>

</div>

<div class="book-container" id="book-list">

        <div class="book-container" id="book-list">

            <div class="book-card">
                <img src="https://covers.openlibrary.org/b/title/Atomic%20Habits-M.jpg"
                    alt="Atomic Habits">

                <h3>Atomic Habits</h3>
                <p>James Clear</p>
                <h4>$15.00</h4>

                <button onclick="addToCart('Atomic Habits', 15)">
                    Add to Cart
                </button>
            </div>

            <div class="book-card">
                <img src="https://covers.openlibrary.org/b/title/Rich%20Dad%20Poor%20Dad-M.jpg"
                    alt="Rich Dad Poor Dad">

                <h3>Rich Dad Poor Dad</h3>
                <p>Robert Kiyosaki</p>
                <h4>$12.00</h4>

                <button onclick="addToCart('Rich Dad Poor Dad', 12)">
                    Add to Cart
                </button>
            </div>

            <div class="book-card">
                <img src="https://covers.openlibrary.org/b/title/Think%20and%20Grow%20Rich-M.jpg"
                    alt="Think and Grow Rich">

                <h3>Think and Grow Rich</h3>
                <p>Napoleon Hill</p>
                <h4>$10.00</h4>

                <button onclick="addToCart('Think and Grow Rich', 10)">
                    Add to Cart
                </button>
            </div>

        </div>

    </section>

    <!-- CUSTOMER DASHBOARD -->
<section id="customer-dashboard" style="display: none;">

    <div class="customer-welcome">
        <h2>Welcome to Your Dashboard</h2>
        <p>Manage your account and track your orders.</p>
    </div>

    <div class="customer-info">
        <h3>My Account</h3>
        <p>Name: <span id="customer-dashboard-name"></span></p>
        <p>Email: <span id="customer-dashboard-email"></span></p>
    </div>

    <div class="customer-menu">
        <button onclick="showCustomerBooks()">
            Browse Books
        </button>

        <button onclick="showCustomerOrders()">
            My Orders
        </button>

        <button onclick="logout()">
            Logout
        </button>
    </div>

    <div class="customer-orders">
        <h3>My Orders</h3>
        <div id="my-orders">
            <p>Your orders will appear here.</p>
        </div>
    </div>

</section>

<!-- CART SECTION -->
<section class="cart-section" id="cart">

    <h2>Shopping Cart</h2>

    <div id="cart-items">
        Your cart is empty.
    </div>

    <h3 id="total-price">Total: $0.00</h3>

    <button onclick="placeOrder()" class="order-btn">
        Place Order
    </button>

    <button onclick="trackOrders()" class="order-btn">
        Track My Orders
    </button>

</section>

<!-- STAFF DASHBOARD -->
<section id="staff-dashboard" style="display: none;">

    <div class="staff-welcome">
        <h2>Staff Dashboard</h2>
        <p>Manage your bookstore operations.</p>
    </div>

    <div class="staff-options">

        <button onclick="showAddBook()">
            Add New Book
        </button>

        <button onclick="viewOrders()">
            View Orders
        </button>

        <button onclick="logout()">
            Logout
        </button>

    </div>

    <!-- ADD BOOK FORM -->
    <div id="add-book-form" style="display: none;">

        <h3>Add New Book</h3>

        <input type="text" id="book-name"
               placeholder="Book Name">

        <input type="text" id="book-author"
               placeholder="Author Name">

        <input type="number" id="book-price"
               placeholder="Book Price">

        <label for="book-category">
            Book Category
        </label>

        <select id="book-category">
            <option value="Programming">Programming</option>
            <option value="History">History</option>
            <option value="Science">Science</option>
            <option value="Business">Business</option>
        </select>

        <button onclick="addNewBook()">
            Add Book
        </button>

    </div>

    <!-- STAFF ORDERS -->
    <div id="orders-panel" style="display: none;">

        <h3>Customer Orders</h3>

        <div id="orders-list">
            <p>No orders available yet.</p>
        </div>

    </div>

</section>

<!-- STAFF DASHBOARD -->
<section id="staff-dashboard" style="display: none;">

    <h2>Staff Dashboard</h2>

    <div class="staff-options">

        <button onclick="showAddBook()">
            Add New Book
        </button>

        <button onclick="viewOrders()">
            View Orders
        </button>

        <button onclick="logout()">
            Logout
        </button>

    </div>
<!-- ADD BOOK FORM -->
<div id="add-book-form" style="display: none;">

    <h3>Add New Book</h3>

    <input type="text" id="book-name"
           placeholder="Book Name">

    <input type="text" id="book-author"
           placeholder="Author Name">

    <input type="number" id="book-price"
           placeholder="Book Price">
    <label for="book-category">Book Category</label>

<select id="book-category">
    <option value="Programming">Programming</option>
    <option value="History">History</option>
    <option value="Science">Science</option>
    <option value="Business">Business</option>
</select>

    <button onclick="addNewBook()">
        Add Book
    </button>

</div>
<!-- ORDERS PANEL -->

<div id="orders-panel" style="display: none;">

    <h3>Customer Orders</h3>

    <div id="orders-list">
        <p>No orders available yet.</p>
    </div>

</div>
</section>

    <!-- ABOUT SECTION -->
    <section class="about-section" id="about">

        <h2>About Our Bookstore</h2>

        <p>
            BOOKSTORE is an online bookstore that helps
            readers discover their favorite books.
            Our goal is to make reading easy and enjoyable.
        </p>

    </section>

    <!-- CONTACT SECTION -->
    <section class="contact-section" id="contact">

        <h2>Contact Us</h2>

        <p>Email: ROMAN@gmail.com</p>
        <p>Phone: +964 750 755 2922</p>

    </section>

    <!-- FOOTER -->
    <footer>

        <h2>BOOKSTORE</h2>

        <p>
            ©️ 2026 BOOKSTORE.
            All Rights Reserved.
        </p>

    </footer>

    <script src="script.js"></script>

</body>
</html>
